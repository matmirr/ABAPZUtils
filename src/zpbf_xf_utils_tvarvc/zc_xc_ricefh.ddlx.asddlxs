@Metadata.layer: #CORE
@UI.headerInfo: { 
    typeName: 'Desarrollo RICEF', 
    typeNamePlural: 'Desarrollos RICEF', 
    title: { type: #STANDARD, value: 'Ricefid' }
}
annotate view ZC_XC_RICEFH with 
{
  @UI.facet: [
    { id: 'Info', type: #COLLECTION, position: 10, label: 'Información del RICEFID' },
    { id: 'GeneralInfo', type: #IDENTIFICATION_REFERENCE, parentId: 'Info', position: 10 },
    { id: 'Items', type: #LINEITEM_REFERENCE, position: 20, label: 'Valores Constantes', targetElement: '_Item' }
  ]


  @UI.lineItem: [{ position: 10 },
                 { type: #FOR_ACTION, dataAction: 'TransportDevelopment', label: 'Transportar Desarrollo', position: 30 }]
  @UI.identification: [{ position: 10 },
                       { type: #FOR_ACTION, dataAction: 'TransportDevelopment', label: 'Transportar Desarrollo', position: 30 }]
  Ricefid;
  
  @UI.lineItem: [{ position: 20 }]
  @EndUserText.label: 'Descripción'
  SessionDescription;
  
  @UI.lineItem: [{ position: 30 }]
  @EndUserText.label: 'Cant. Constantes'
  VariantsCount;

  @UI.hidden: true
  CreatedBy;
  @UI.hidden: true
  CreatedAt;
  @UI.hidden: true
  LastChangedBy;
  @UI.hidden: true
  LastChangedAt;
  @UI.hidden: true
  LocalLastChg;
}